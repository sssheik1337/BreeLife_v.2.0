# Название приложения
APP_NAME=BreeLife

# Окружение приложения
APP_ENV=development

# Хост приложения
APP_HOST=127.0.0.1

# Порт приложения
APP_PORT=8000

# Режим отладки (true/false)
DEBUG=

# Включение AI (true/false)
AI_ENABLED=false

# Токен Telegram бота
TELEGRAM_BOT_TOKEN=

# URL вебхука Telegram
TELEGRAM_WEBHOOK_URL=

# URL для Telegram WebApp
TELEGRAM_WEBAPP_URL=

# Провайдер платежей
PAYMENT_PROVIDER=mock

# Публичный ключ платежей
PAYMENT_PUBLIC_KEY=

# Секретный ключ платежей
PAYMENT_SECRET_KEY=

# API-ключ Yandex GPT
YANDEX_GPT_API_KEY=

# ID папки Yandex GPT
YANDEX_GPT_FOLDER_ID=
