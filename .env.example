# Название приложения
APP_NAME=BreeLife

# Режим приложения (development/production)
APP_ENV=development

# Тестовый Telegram user id для DEV режима
DEV_TELEGRAM_USER_ID=999001

# Хост приложения
APP_HOST=127.0.0.1

# Порт приложения
APP_PORT=8000

# Режим отладки (true/false)
DEBUG=false

# Включение AI (true/false)
AI_ENABLED=false

# Включение напоминаний (true/false)
REMINDERS_ENABLED=false

# Токен Telegram бота
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# URL для Telegram WebApp (например, локально через ngrok: https://<subdomain>.ngrok.io/profile)
TELEGRAM_WEBAPP_URL=https://example.com/profile

# Публичный URL приложения (если отличается от WebApp URL)
PUBLIC_APP_URL=https://example.com/profile

# Базовый публичный URL для webhook (например, https://<subdomain>.ngrok.io)
PUBLIC_BASE_URL=https://example.com

# Провайдер платежей
PAYMENT_PROVIDER=stripe

# Публичный ключ платежей
PAYMENT_PUBLIC_KEY=pk_test_example

# Секретный ключ платежей
PAYMENT_SECRET_KEY=sk_test_example

# API-ключ Yandex GPT
YANDEX_GPT_API_KEY=your-yandex-gpt-api-key

# ID папки Yandex GPT
YANDEX_GPT_FOLDER_ID=your-yandex-folder-id

# Путь к базе данных SQLite
DB_PATH=/path/to/breelife.sqlite3

# Данные доступа в админку
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
