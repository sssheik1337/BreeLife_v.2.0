# Название приложения
APP_NAME=BreeLife

# Окружение приложения
APP_ENV=development

# Хост приложения
APP_HOST=127.0.0.1

# Порт приложения
APP_PORT=8000

# Режим отладки (true/false)
DEBUG=false

# Включение AI (true/false)
AI_ENABLED=false

# Включение напоминаний (true/false)
REMINDERS_ENABLED=false

# Токен Telegram бота
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# URL вебхука Telegram (для локального тестирования через ngrok: https://<subdomain>.ngrok.io/telegram/webhook)
TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook

# URL для Telegram WebApp (например, локально через ngrok: https://<subdomain>.ngrok.io)
TELEGRAM_WEBAPP_URL=https://example.com/webapp

# Провайдер платежей
PAYMENT_PROVIDER=stripe

# Публичный ключ платежей
PAYMENT_PUBLIC_KEY=pk_test_example

# Секретный ключ платежей
PAYMENT_SECRET_KEY=sk_test_example

# API-ключ Yandex GPT
YANDEX_GPT_API_KEY=your-yandex-gpt-api-key

# ID папки Yandex GPT
YANDEX_GPT_FOLDER_ID=your-yandex-folder-id

# Путь к базе данных SQLite
DB_PATH=/path/to/breelife.sqlite3

# Данные доступа в админку
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
