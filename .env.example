# BreeLife: пример переменных окружения
# Файл .env не должен попадать в git.

# Название приложения
APP_NAME=BreeLife

# Режим приложения: development | production
APP_ENV=development

# Dev-логин без Telegram (для локальной разработки)
DEV_AUTH_ENABLED=0
DEV_TELEGRAM_USER_ID=999001

# Хост/порт backend
APP_HOST=127.0.0.1
APP_PORT=8000

# Логи/отладка
DEBUG=false
APP_DEBUG=false

# Включение AI (true/false)
AI_ENABLED=false

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_HIDDEN_ADMIN_COMMAND=adminbreeva

# Публичный адрес приложения (MiniApp)
# Достаточно указать ОДИН вариант, остальное будет вычислено автоматически:
# 1) PUBLIC_APP_URL (рекомендуется)
# 2) TELEGRAM_WEBAPP_URL (обратная совместимость)
# 3) PUBLIC_BASE_URL (если указать только его, MiniApp откроется по / и попадёт в /app/ через редирект)
#
# Пример: https://example.com/app/
PUBLIC_APP_URL=

# Опционально: если webhook/уведомления должны использовать другой origin (например, другой туннель).
# Если не задано, origin берётся из PUBLIC_APP_URL.
# Пример: https://example.com
PUBLIC_BASE_URL=

# Обратная совместимость: можно оставить пустым, если задан PUBLIC_APP_URL.
TELEGRAM_WEBAPP_URL=

# Платежи (позже подключим ЮКасса)
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# YandexGPT
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=

# SQLite базы (обязательно абсолютные пути; не храните БД внутри репозитория)
# Пример Windows: C:\\data\\breelife\\app.sqlite3
# Пример Linux: /var/lib/breelife/app.sqlite3
DB_PATH=

# Пример Windows: C:\\data\\breelife\\products.sqlite3
# Пример Linux: /var/lib/breelife/products.sqlite3
PRODUCTS_DB_PATH=

# Доступ в админку
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Напоминания: это НЕ включатели/выключатели.
# Пользователь включает/выключает напоминания в интерфейсе, а эти параметры задают технический режим сервера:
# - как часто воркер проверяет расписание
# - какой шаг времени использовать по умолчанию
REMINDERS_WORKER_POLL_SECONDS=60
WATER_REMINDER_INTERVAL_MINUTES=90
WAKE_WATER_DELAY_MINUTES=45
