# BreeLife: пример переменных окружения
# Файл .env не должен попадать в git.

# Название приложения
APP_NAME=BreeLife

# Режим приложения: development | production
APP_ENV=development

# Разрешить dev-логин без Telegram (0/1)
DEV_AUTH_ENABLED=0

# Тестовый Telegram user id для DEV режима (используется только при DEV_AUTH_ENABLED=1)
DEV_TELEGRAM_USER_ID=999001

# Хост/порт backend
APP_HOST=127.0.0.1
APP_PORT=8000

# Логи/отладка
DEBUG=false
APP_DEBUG=false

# Включение AI (true/false)
AI_ENABLED=false

# Версия алгоритма рациона
MEAL_PLAN_ALGO_VERSION=v2

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_HIDDEN_ADMIN_COMMAND=adminbreeva

# URL MiniApp (Telegram WebApp). Рекомендуется указывать /app/
# Пример: https://example.com/app/
TELEGRAM_WEBAPP_URL=

# Публичный URL приложения (если отличается)
PUBLIC_APP_URL=

# Публичный базовый URL для webhook (например: https://example.com)
PUBLIC_BASE_URL=

# Платежи (позже переключим на ЮКасса)
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# YandexGPT
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=

# База данных приложения (SQLite). ОБЯЗАТЕЛЬНО абсолютный путь.
# Пример Windows: C:\\data\\breelife\\app.sqlite3
# Пример Linux: /var/lib/breelife/app.sqlite3
DB_PATH=

# База продуктов (SQLite). ОБЯЗАТЕЛЬНО абсолютный путь.
# Пример Windows: C:\\data\\breelife\\products.sqlite3
# Пример Linux: /var/lib/breelife/products.sqlite3
PRODUCTS_DB_PATH=

# Доступ в админку
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Напоминания (интервалы)
REMINDERS_WORKER_POLL_SECONDS=60
WATER_REMINDER_INTERVAL_MINUTES=90
WAKE_WATER_DELAY_MINUTES=45